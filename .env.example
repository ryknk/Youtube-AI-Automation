# APIキーは各サービスで発行した値を .env に設定してください。
OPENAI_API_KEY=your_openai_api_key_here
# Black Forest Labs画像生成APIのキー
BFL_API_KEY=your_bfl_api_key_here

# DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# 出力先（プロジェクトルートからの相対パス）
OUTPUT_DIR=output
LOG_DIR=logs
CONFIG_DIR=config
CACHE_DIR=cache
HISTORY_FILE=logs/run_history.jsonl
